# --- Secret/Sensitive Files ---
# Keeps your database credentials private
.env
.streamlit/secrets.toml

# --- Python System Files ---
# These are generated by Python automatically and aren't needed in GitHub
__pycache__/
*.pyc
*.pyo
*.pyd

# --- macOS System Files ---
# These are invisible files created by your Mac that aren't useful in a repo
.DS_Store

# --- IDE/Editor Folders ---
# Keeps your VS Code or PyCharm settings local to your computer
.vscode/
.idea/
